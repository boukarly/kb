# Frontend public configuration (safe to expose to the browser)
VITE_INSFORGE_BASE_URL="https://your-project.eu-central.insforge.app"
VITE_INSFORGE_ANON_KEY="YOUR_INSFORGE_ANON_KEY"
VITE_APP_URL="http://localhost:3000"

# Server-side InsForge configuration (NEVER expose with a VITE_ prefix)
INSFORGE_BASE_URL="https://your-project.eu-central.insforge.app"
INSFORGE_ADMIN_KEY="YOUR_INSFORGE_ADMIN_KEY"

# Fixed InsForge owner used by this single-user knowledge base
MCP_OWNER_ID="00000000-0000-0000-0000-000000000000"

# Standard OAuth protection for remote MCP clients (ChatGPT / Claude)
# The issuer MUST expose OAuth/OIDC discovery and support an MCP-compatible
# authorization-code + PKCE flow (CIMD, DCR, or a pre-registered client).
MCP_OAUTH_ISSUER="https://api.insforge.dev"
MCP_OAUTH_USERINFO_URL="https://api.insforge.dev/auth/v1/profile"
MCP_ALLOWED_EMAIL="you@example.com"

# Optional local/debug fallback only. ChatGPT/claude.ai connectors do not
# generally accept a custom pasted API key as their OAuth mechanism.
MCP_STATIC_API_KEY="replace-with-a-long-random-debug-secret"

# Public canonical application origin. Required in production so OAuth
# resource metadata never advertises an internal/proxy URL.
APP_URL="https://your-app.vercel.app"

NODE_ENV="production"
