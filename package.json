{
  "name": "mansour-knowledge-base",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "insforge:function:deploy": "npx @insforge/cli functions deploy process-document --file ./insforge/functions/process-document.ts --name \"Process document\" --description \"Extract PDF/DOCX text and build knowledge chunks\"",
    "insforge:function:logs": "npx @insforge/cli logs function.logs --limit 100"
  },
  "dependencies": {
    "@insforge/sdk": "1.5.2",
    "@modelcontextprotocol/server": "2.0.0",
    "lucide-react": "0.546.0",
    "mcp-handler": "2.1.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.14.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.14",
    "typescript": "5.8.2",
    "vite": "6.2.3"
  },
  "engines": {
    "node": ">=20"
  }
}
